; Wacki 3DS: vertex shader of the 2D drawing (video_3ds_c3d.c).
; From ReClaw (Herbaciarz, GPL-3.0): reclaw2d.v.pica, unchanged.
; In: v0 position (x, y), v1 texture coordinates, v2 colour (0..255).
; Out: position (projected), texture coordinates, colour (0..1).

.fvec projection[4]

.constf consts(0.0, 1.0, 0.00392156862745098, 0.0)
.alias zero consts.xxxx
.alias one  consts.yyyy
.alias inv255 consts.zzzz

.out outpos position
.out outtc0 texcoord0
.out outclr color

.alias inpos v0
.alias intc  v1
.alias inclr v2

.proc main
	mov r0.xy, inpos.xy
	mov r0.z, zero
	mov r0.w, one

	dp4 outpos.x, projection[0], r0
	dp4 outpos.y, projection[1], r0
	dp4 outpos.z, projection[2], r0
	dp4 outpos.w, projection[3], r0

	mov outtc0, intc
	mul outclr, inv255, inclr
	end
.end
